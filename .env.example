# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# The role you are sourcing for
ROLE_TITLE=Product Designer
ROLE_CITY=London
# Optional: comma-separated skills the shortlist must list
ROLE_SKILLS=

# How far back to read posts
SINCE_DAYS=180

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude writes the opener (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
